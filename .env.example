# ── KIS (한국투자증권) ────────────────────────────────────────────────────────
# https://apiportal.koreainvestment.com → 앱 키 발급
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_CANO=12345678
KIS_ACNT_PRDT_CD=01
# true = 모의투자(VTTC) 모드로 라우팅, false = 실거래(TTTT)
KIS_MOCK=true
# 모의투자 전용 앱키/계좌(실전과 별개 발급) — KIS_MOCK=true일 때 사용
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_CANO=

# ── Alpaca (미국주식) ─────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── Hyperliquid (선물) ────────────────────────────────────────────────────────
HL_ACCOUNT_ADDRESS=
HL_PRIVATE_KEY=
HL_TESTNET_ACCOUNT_ADDRESS=
HL_TESTNET_PRIVATE_KEY=

# ── Interactive Brokers ───────────────────────────────────────────────────────
# TWS 또는 IB Gateway 실행 필요
IB_HOST=127.0.0.1
IB_PORT=7497

# ── 리스크 리밋 (venue별 KR/HL) ────────────────────────────────────────────────
DAILY_LOSS_LIMIT_KR=
DAILY_LOSS_LIMIT_HL=
MAX_ORDER_NOTIONAL_KR=
MAX_ORDER_NOTIONAL_HL=
MAX_ORDER_QTY_KR=
MAX_ORDER_QTY_HL=
MAX_POSITION_QTY_KR=
MAX_POSITION_QTY_HL=

# ── 리서치 데이터 API ──────────────────────────────────────────────────────────
DATA_GO_KR_API_KEY=
ECOS_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
OPENDART_API_KEY=
KRX_API_KEY=
KRX_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── 알림 (텔레그램) ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Mobile API (Tailscale/LAN에서 오는 요청 인증) ──────────────────────────────
# 아무 랜덤 문자열. iOS 앱 APIClient.swift의 apiKey와 값 맞출 것.
MOBILE_API_KEY=your_random_key_here

# ── 웹 로그인 (클라우드 배포 대비, 2026-09-09) ─────────────────────────────────
# 대시보드 로그인 비밀번호. 미설정 시 원격(비-loopback) 요청은 X-Api-Key만으로 통과.
ADMIN_PASSWORD=your_login_password_here
# 세션 쿠키 서명용. 미설정 시 프로세스 기동마다 랜덤 생성(재시작하면 재로그인 필요) — 재시작 걸쳐
# 세션 유지하려면 고정값 지정: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# 클라우드(HTTPS)에서는 true로 — 세션 쿠키에 Secure 플래그 부여. 로컬 http 개발에서는 비워둘 것.
COOKIE_SECURE=
# api.<도메인>/app.<도메인> 서브도메인 분리 배포 시 none으로(COOKIE_SECURE=true 필수 동반).
# 같은 사이트로 서비스하면 기본 lax 유지.
COOKIE_SAMESITE=
# 프론트엔드 오리진(쉼표구분). 로컬 기본 http://localhost:3000, 클라우드는 https://app.<도메인>
CORS_ORIGINS=

# ── Web Push (PWA 알림) ────────────────────────────────────────────────────────
# 생성: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); ..."
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@seokminal.dev

# ── 무인 운영 워치독 (클라우드 배포) ───────────────────────────────────────────
# api-watchdog의 uvicorn RSS 상한(MB). 기본 4000(맥 기준) — VM은 RAM의 40%
# 안팎으로 낮출 것(예: 1GB VM → 400).
SEOKMINAL_RSS_LIMIT_MB=
