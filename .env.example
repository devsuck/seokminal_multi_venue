# ── KIS (한국투자증권) ────────────────────────────────────────────────────────
# https://apiportal.koreainvestment.com → 앱 키 발급
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 계좌번호 (8자리) 와 상품코드 (01=주식)
KIS_CANO=12345678
KIS_ACNT_PRDT_CD=01

# true = 모의투자(VTTC), false = 실거래(TTTT)
KIS_MOCK=true

# ── Interactive Brokers ───────────────────────────────────────────────────────
# TWS 또는 IB Gateway 실행 필요
IB_HOST=127.0.0.1
IB_PORT=7497

# ── Mobile API (Tailscale/LAN에서 오는 요청 인증) ──────────────────────────────
# 아무 랜덤 문자열. iOS 앱 APIClient.swift의 apiKey와 값 맞출 것.
MOBILE_API_KEY=your_random_key_here

# ── 웹 로그인 (클라우드 배포 대비, 2026-09-09) ─────────────────────────────────
# 대시보드 로그인 비밀번호. 미설정 시 원격(비-loopback) 요청은 X-Api-Key만으로 통과.
ADMIN_PASSWORD=your_login_password_here
# 세션 쿠키 서명용. 미설정 시 프로세스 기동마다 랜덤 생성(재시작하면 재로그인 필요) — 재시작 걸쳐
# 세션 유지하려면 고정값 지정: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# 클라우드(HTTPS)에서는 true로 — 세션 쿠키에 Secure 플래그 부여. 로컬 http 개발에서는 비워둘 것.
COOKIE_SECURE=

# ── Web Push (PWA 알림) ────────────────────────────────────────────────────────
# 생성: python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); ..."
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@seokminal.dev
