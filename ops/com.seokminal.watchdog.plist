<?xml version="1.0" encoding="UTF-8"?>
<!-- 수집기 함대 워치독 launchd 에이전트. ~/Library/LaunchAgents/ 에 복사 후
     아래 <경로> 2곳(WorkingDirectory, ProgramArguments의 python)을 실제값으로 수정.
     launchctl load ~/Library/LaunchAgents/com.seokminal.watchdog.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.seokminal.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>-m</string>
        <string>ops.collector_watchdog</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/절대경로/seokminal_multi_venue</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/seokminal_watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/seokminal_watchdog.err</string>
</dict>
</plist>
