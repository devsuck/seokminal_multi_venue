<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Research Capture 배치 — 평일 08:00(로컬)에 run_research_capture.sh 1회 실행
  (research_scheduler.CYCLES["daily"]의 "research_ledger_sync" 태스크 cadence "0 8 * * 1-5"와 정합).
  autoresearch/daily-summary와 같은 패턴(비침습, launchd가 주기 실행). 추적 전략의 현재 위원회
  평가를 예측 레지스트리에 사전등록(멱등, 중복 skip) — 이래야 P205 Edge Score가 horizon 후
  실제 채점 가능(지금은 표본 0으로 고정돼있던 것을 풀어줌). 어떤 전략도 자동 승격하지 않음.

  설치(경로/파이썬을 실제에 맞게 수정 — <REPO>는 맥의 seokminal-multi-venue 절대경로):
    cp scripts/deploy/launchd/com.seokminal.research-ledger-sync.plist ~/Library/LaunchAgents/
    # ~/Library/LaunchAgents/com.seokminal.research-ledger-sync.plist 안의 <REPO>/<PYTHON> 치환
    launchctl load ~/Library/LaunchAgents/com.seokminal.research-ledger-sync.plist
    launchctl list | grep seokminal      # 등록 확인
    tail -f <REPO>/logs/research_ledger_sync.log
  해제: launchctl unload ~/Library/LaunchAgents/com.seokminal.research-ledger-sync.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.seokminal.research-ledger-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string><REPO>/scripts/deploy/run_research_capture.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SEOKMINAL_REPO</key>
        <string><REPO></string>
        <key>SEOKMINAL_PYTHON</key>
        <string><PYTHON></string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string><REPO>/logs/research_ledger_sync.log</string>
    <key>StandardErrorPath</key>
    <string><REPO>/logs/research_ledger_sync.log</string>
</dict>
</plist>
