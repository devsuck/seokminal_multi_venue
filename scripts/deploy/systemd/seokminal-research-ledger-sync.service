# Research Capture 배치(P205 Edge Score 표본 축적) — launchd
# com.seokminal.research-ledger-sync.plist의 systemd 버전. <REPO_USER>/<REPO_PATH> 치환 후
#   sudo cp seokminal-research-ledger-sync.service seokminal-research-ledger-sync.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now seokminal-research-ledger-sync.timer
[Unit]
Description=seokminal Research Capture 배치

[Service]
Type=oneshot
User=<REPO_USER>
WorkingDirectory=<REPO_PATH>
Environment=SEOKMINAL_PYTHON=<REPO_PATH>/.venv/bin/python
Environment=SEOKMINAL_REPO=<REPO_PATH>
EnvironmentFile=<REPO_PATH>/.env
ExecStart=/bin/bash <REPO_PATH>/scripts/deploy/run_research_capture.sh
