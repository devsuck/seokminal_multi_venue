# Polymarket 샤프월렛 틱 수집기 — 파일럿 상시서비스(systemd).
#
# 이게 파일럿 대상인 이유: 순수 HTTP 폴링(브로커 무관) + 무한루프 진입점이라
# "ARM에서 파이썬 상시서비스가 안 죽고 도는가"를 최소 리스크로 검증한다.
# (내부적으로 이미 try/except로 사이클 에러를 삼키고 계속 도는 구조 —
#  research/run_polymarket_sharp_wallet_collect.py 의 run_forever)
#
# 설치(VM에서, 유저/경로는 실제에 맞게 수정 — 오라클 우분투 기본 유저는 ubuntu):
#   sudo cp scripts/deploy/systemd/sharp-wallet-collect.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sharp-wallet-collect
#   systemctl status sharp-wallet-collect
#   journalctl -u sharp-wallet-collect -f     # 또는 아래 로그파일 tail
#
# 경로 전제: 레포가 /home/ubuntu/seokminal_multi_venue 에 clone, venv는 .venv.
# 다르면 아래 User/WorkingDirectory/ExecStart/EnvironmentFile 경로를 고칠 것.

[Unit]
Description=Polymarket sharp-wallet tick collector (pilot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/seokminal_multi_venue
EnvironmentFile=/home/ubuntu/seokminal_multi_venue/.env
ExecStart=/home/ubuntu/seokminal_multi_venue/.venv/bin/python -m research.run_polymarket_sharp_wallet_collect
Restart=always
RestartSec=10
# 재시작 폭주 방지: 5분에 5회 넘게 죽으면 잠깐 멈춤
StartLimitIntervalSec=300
StartLimitBurst=5
StandardOutput=append:/home/ubuntu/seokminal_multi_venue/logs/sharp-wallet-collect.log
StandardError=append:/home/ubuntu/seokminal_multi_venue/logs/sharp-wallet-collect.log

[Install]
WantedBy=multi-user.target
